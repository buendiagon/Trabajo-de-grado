{
    "ltex.enabled": false,
    "terminal.integrated.env.linux": {
        "GTK_PATH": ""
    },
    "cSpell.language": "en,es",
    "cSpell.enabled": true,
    "cSpell.words": [
        "AADL",
        "agregador",
        "agregadores",
        "AMQP",
        "deserialización",
        "deserializarlos",
        "editables",
        "metamodelo",
        "MQTT",
        "reimplementación",
        "serializado"
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.outDir": ".",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "latexmk"
}
