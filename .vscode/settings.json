{
    "ltex.enabled": false,
    "terminal.integrated.env.linux": {
        "GTK_PATH": ""
    },
    "cSpell.language": "en,es",
    "cSpell.enabled": true,
    "cSpell.words": [
        "AADL",
        "agregador",
        "agregadores",
        "AMQP",
        "deserialización",
        "deserializarlos",
        "editables",
        "metamodelo",
        "MQTT",
        "reimplementación",
        "serializado"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "--input-directory=%OUTDIR%",
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex -> biber -> pdflatex x2",
            "tools": [
                "pdflatex",
                "biber",
                "pdflatex",
                "pdflatex"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "pdflatex -> biber -> pdflatex x2"
}